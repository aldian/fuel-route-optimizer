          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns nearby stations within radius', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.count).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
